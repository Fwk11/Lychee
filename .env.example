# Lychee 服务配置（复制为 .env 后按需修改；.env 已被 git 忽略）
# API 密钥：不设置则首次启动自动生成并写入 .env
LYCHEE_API_KEY=
# 监听地址：默认仅本机回环，局域网不可访问；如需局域网访问再改 0.0.0.0（务必保留密钥）
LYCHEE_HOST=127.0.0.1
LYCHEE_PORT=8000
# 每IP每分钟请求上限
LYCHEE_RATE_LIMIT=120
# 请求体大小上限（字节）
LYCHEE_MAX_BODY=2097152
# VLM 配置（本地 Ollama）
VLM_MODEL=qwen2.5vl:3b
VLM_MAX_SIDE=320
# 可选：QQ音乐在线推荐网关
# QQMUSIC_API_BASE=http://127.0.0.1:3300
